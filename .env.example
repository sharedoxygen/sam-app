# =============================================================================
# AGENT SALES ACTIVITY MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# 
# ⚠️  SECURITY NOTICE:
# - This is a TEMPLATE - contains NO real credentials
# - Copy to .env: cp .env.example .env
# - Replace ALL placeholders with real values
# - NEVER commit .env files to Git
#
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

# Database Host (localhost, RDS endpoint, etc.)
DATABASE_HOST="localhost"
DATABASE_PORT="5432"
DATABASE_USER="postgres"

# ⚠️  REPLACE WITH YOUR ACTUAL PASSWORD
DATABASE_PASSWORD="YOUR_SECURE_PASSWORD_HERE"
DB_PASSWORD="YOUR_SECURE_PASSWORD_HERE"

# Database Schema
DB_SCHEMA="public"

# Database Names
DATABASE_NAME_PRODUCTION="asam"
DATABASE_NAME_DEVELOPMENT="asam_d"
DATABASE_NAME_TEST="asam_t"
DATABASE_NAME="asam_d"

# Database URLs - REPLACE <PASSWORD> and <HOST> with actual values
DATABASE_URL="postgresql://postgres:<PASSWORD>@<HOST>:5432/asam_d?schema=public"
DATABASE_URL_PRODUCTION="postgresql://postgres:<PASSWORD>@<HOST>:5432/asam?schema=public"
DATABASE_URL_DEVELOPMENT="postgresql://postgres:<PASSWORD>@<HOST>:5432/asam_d?schema=public"
DATABASE_URL_TEST="postgresql://postgres:<PASSWORD>@<HOST>:5432/asam_t?schema=public"

# -----------------------------------------------------------------------------
# NEXTAUTH CONFIGURATION
# -----------------------------------------------------------------------------

NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="YOUR_NEXTAUTH_SECRET_HERE"

# Optional (generate with: openssl rand -hex 32)
NEXTAUTH_PREVIEW_ID="optional_preview_id"
NEXTAUTH_PREVIEW_SIGNING_KEY="optional_signing_key"
NEXTAUTH_PREVIEW_ENCRYPTION_KEY="optional_encryption_key"

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

NODE_ENV="development"
NEXT_PUBLIC_IS_TEST_ENV="false"

# -----------------------------------------------------------------------------
# SETUP INSTRUCTIONS
# -----------------------------------------------------------------------------
# 1. cp .env.example .env
# 2. openssl rand -base64 32  (for NEXTAUTH_SECRET)
# 3. Replace ALL placeholders with real values
# 4. Test: npm run dev
# -----------------------------------------------------------------------------
