pipeline {
    agent any
    
    environment {
        NODE_VERSION = '18'
        PORT = '3000'
        // Use CI-friendly database URL
        DATABASE_URL = credentials('database-url') ?: 'file:./dev.db'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'echo "Repository checked out successfully"'
                sh 'ls -la'
            }
        }
        
        stage('Setup Node.js') {
            steps {
                sh '''
                    echo "Setting up Node.js environment..."
                    
                    # Check if Node.js is available
                    if command -v node >/dev/null 2>&1; then
                        echo "Node.js version: $(node --version)"
                        echo "npm version: $(npm --version)"
                    else
                        echo "Node.js not found, checking alternatives..."
                        export PATH="/usr/local/bin:$PATH"
                        echo "Node.js version: $(node --version)"
                        echo "npm version: $(npm --version)"
                    fi
                '''
            }
        }
        
        stage('Install Dependencies') {
            steps {
                sh '''
                    echo "Installing dependencies..."
                    
                    # Clean install
                    rm -rf node_modules package-lock.json
                    
                    # Install main dependencies
                    npm install --no-optional --no-fund --silent
                    
                    echo "Dependencies installed successfully"
                    echo "Installed packages: $(ls node_modules | wc -l)"
                '''
            }
        }
        
        stage('Generate Prisma Client') {
            steps {
                sh '''
                    echo "Generating Prisma client..."
                    npx prisma generate || echo "Prisma generation failed - continuing"
                '''
            }
        }
        
        stage('Lint Check') {
            steps {
                sh '''
                    echo "Running lint check..."
                    npm run lint || echo "Lint completed with warnings - continuing"
                '''
            }
        }
        
        stage('Build Application') {
            steps {
                sh '''
                    echo "Building application..."
                    npm run build
                    echo "Build completed successfully"
                '''
            }
        }
        
        stage('Run Tests') {
            steps {
                sh '''
                    echo "Running tests..."
                    npm test || echo "Tests completed - check results"
                '''
            }
        }
        
        stage('Deploy') {
            steps {
                script {
                    def deployPort = 3000
                    def deployName = env.BRANCH_NAME
                    
                    // Set deployment target based on branch
                    switch(env.BRANCH_NAME) {
                        case 'in-progress':
                            echo "📋 Branch: in-progress - Build and test only (no deployment)"
                            currentBuild.description = "Build #${BUILD_NUMBER} - in-progress: Development work (build/test only)"
                            break
                        case 'development':
                            deployPort = 3001
                            deployName = "Development"
                            currentBuild.description = "Build #${BUILD_NUMBER} - development: Integration testing → localhost:${deployPort}"
                            break
                        case 'publish':
                            deployPort = 3002
                            deployName = "Staging"
                            currentBuild.description = "Build #${BUILD_NUMBER} - publish: Current revision staging → localhost:${deployPort}"
                            break
                        case 'main':
                            deployPort = 3000
                            deployName = "Production"
                            currentBuild.description = "Build #${BUILD_NUMBER} - main: Production golden copy → localhost:${deployPort}"
                            break
                        default:
                            echo "Unknown branch: ${env.BRANCH_NAME}"
                            deployPort = 3003
                            deployName = "Feature"
                    }
                    
                    if (env.BRANCH_NAME != 'in-progress') {
                        sh """
                            echo "🚀 Deploying ${deployName} to localhost:${deployPort}"
                            
                            # Kill any existing process on this port
                            pkill -f "next.*${deployPort}" || true
                            sleep 2
                            
                            # Start the application on the designated port
                            echo "Starting application on port ${deployPort}..."
                            export PORT=${deployPort}
                            nohup npm start > deployment_${deployPort}.log 2>&1 &
                            
                            # Wait a moment for startup
                            sleep 5
                            
                            # Verify deployment
                            if curl -f http://localhost:${deployPort}/api/health 2>/dev/null; then
                                echo "✅ ${deployName} deployment successful on localhost:${deployPort}"
                            else
                                echo "⚠️ ${deployName} deployment may need manual verification"
                                echo "Check logs: tail deployment_${deployPort}.log"
                            fi
                        """
                    }
                }
            }
        }
    }
    
    post {
        always {
            sh '''
                echo "Pipeline completed"
                echo "Workspace: $(pwd)"
                echo "Build artifacts:"
                ls -la .next/ 2>/dev/null || echo "No .next directory found"
            '''
        }
        success {
            script {
                def message = ""
                switch(env.BRANCH_NAME) {
                    case 'in-progress':
                        message = "✅ Development build successful - Ready for testing"
                        break
                    case 'development':
                        message = "✅ Integration deployment successful → http://localhost:3001"
                        break
                    case 'publish':
                        message = "✅ Staging deployment successful → http://localhost:3002"
                        break
                    case 'main':
                        message = "✅ Production deployment successful → http://localhost:3000"
                        break
                }
                echo message
                currentBuild.result = 'SUCCESS'
            }
        }
        failure {
            script {
                echo "❌ Pipeline failed for branch: ${env.BRANCH_NAME}"
                echo "Check console output for details"
                currentBuild.result = 'FAILURE'
            }
        }
        unstable {
            echo "⚠️ Pipeline completed with warnings"
        }
    }
} 