{
  "name": "sales-activity-manager",
  "version": "1.0.0",
  "description": "Sales Activity Manager for tracking sales activities",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:watch": "next dev --turbo",
    "build": "next build",
    "build:clean": "rm -rf .next && next build",
    "build:full": "rm -rf .next && rm -rf node_modules/.prisma/client && prisma generate && next build",
    "build:test": "dotenv -e .env.test -- next build",
    "build:test:clean": "rm -rf .next && dotenv -e .env.test -- prisma generate && dotenv -e .env.test -- next build",
    "start": "next start",
    "start:test": "dotenv -e .env.test -- next start",
    "test:deploy": "npm run build:test && npm run start:test",
    "test:quick": "npm run build && PORT=7025 npm run start",
    "workflow:test": "echo '🔨 Building stable version...' && npm run build && echo '🚀 Deploying to test port...' && PORT=7025 npm run start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "db:seed": "npx ts-node prisma/seed-enhanced.ts",
    "db:export-baseline": "npx tsx scripts/export-seed-data.ts",
    "db:seed-baseline": "npx tsx prisma/seed-from-baseline.ts",
    "db:check-integrity": "npx tsx scripts/check-data-integrity.ts",
    "db:load": "./scripts/db-seed-manager.sh load",
    "db:unload": "./scripts/db-seed-manager.sh unload",
    "db:reload": "./scripts/db-seed-manager.sh reload",
    "db:status": "./scripts/db-seed-manager.sh status",
    "db:load:dev": "./scripts/db-seed-manager.sh load development enhanced",
    "db:load:test": "./scripts/db-seed-manager.sh load test enhanced",
    "db:load:prod": "./scripts/db-seed-manager.sh load production enhanced",
    "db:setup:test": "dotenv -e .env.test -- prisma db push && dotenv -e .env.test -- npm run db:seed",
    "db:reset:test": "dotenv -e .env.test -- prisma db push --force-reset && dotenv -e .env.test -- npm run db:seed",
    "compile:sass": "sass src/styles/globals.scss src/styles/compiled/globals.css",
    "watch:sass": "sass --watch src/styles/globals.scss src/styles/compiled/globals.css",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:timezone": "jest --testPathPattern=timezone --verbose",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "style:check": "./scripts/check-no-inline-styles.sh",
    "style:progress": "./scripts/complete-css-modules-refactoring.sh",
    "precommit": "./scripts/check-no-inline-styles.sh",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed-from-baseline.ts"
  },
  "author": "Shared Oxygen",
  "license": "MIT",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@next/swc-darwin-arm64": "^14.1.0",
    "@prisma/client": "^6.8.2",
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.6",
    "chart.js": "^4.4.9",
    "date-fns": "^4.1.0",
    "next": "^14.1.0",
    "next-auth": "^4.24.5",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.10",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.17.47",
    "@types/pg": "^8.10.9",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-unused-imports": "^3.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.1.0",
    "msw": "^2.2.3",
    "prettier": "^3.2.5",
    "prisma": "^6.8.2",
    "sass": "^1.71.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
