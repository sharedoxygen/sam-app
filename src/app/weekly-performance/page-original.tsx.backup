                                </span>
                              </div>
                              <div className="metric-value">{agent.actual.sales}</div>
                              <div className="metric-target">Target: {agent.forecast.sales}</div>
                              <div className="metric-progress">
                                <div className="progress-bar">
                                  <div
                                    className="progress-fill"
                                    ref={(el) => {
                                      if (el) {
                                        el.style.width = `${Math.min(agent.performanceMetrics.sales.percentage, 100)}%`;
                                        el.style.background = agent.performanceMetrics.sales.percentage >= 100
