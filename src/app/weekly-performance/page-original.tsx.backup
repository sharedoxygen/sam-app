                            <div className="metric-info">
                              <h4 className="metric-title">Life/Sales Conversations</h4>
                              <div className="metric-achievement">
                                <span
                                  className={`achievement-percentage ${individualPerformance.performanceMetrics.lifeSalesConversations
                                    .percentage >= 100
                                    ? 'success'
                                    : individualPerformance.performanceMetrics
                                      .lifeSalesConversations.percentage >= 80
                                      ? 'warning'
                                      : 'danger'
                                    }`}
                                >
                                  {individualPerformance.performanceMetrics.lifeSalesConversations.percentage.toFixed(
                                    1
                                  )}
                                  %
                                </span>
                                <span className="achievement-label">achievement</span>
                              </div>
                            </div>
                          </div>
                          <div className="metric-comparison">
                            <div className="comparison-bar">
                              <div className="target-bar">
                                <div
                                  ref={(el) => {
                                    if (el) {
                                      el.style.width = '100%';
                                    }
                                  }}
                                  className={`target-fill ${styles.targetFill}`}
                                ></div>
                                <span className="target-value">
                                  {individualPerformance.forecast.lifeSalesConversations}
                                </span>
                                <span className="target-label">Target</span>
                              </div>
                              <div className="actual-bar">
                                <div
                                  ref={(el) => {
                                    if (el) {
                                      el.style.width = `${Math.min(individualPerformance.performanceMetrics.lifeSalesConversations.percentage, 100)}%`;
                                    }
                                  }}
                                  className={`actual-fill ${styles.actualFill}`}
                                ></div>
                                <span className="actual-value">
                                  {individualPerformance.actual.lifeSalesConversations}
                                </span>
                                <span className="actual-label">Actual</span>
                              </div>
                            </div>
                            <div className="variance-indicator">
                              <span
                                className={`variance ${individualPerformance.performanceMetrics.lifeSalesConversations.variance >= 0 ? 'positive' : 'negative'}`}
                              >
                                {individualPerformance.performanceMetrics.lifeSalesConversations
                                  .variance >= 0
                                  ? '+'
                                  : ''}
                                {
                                  individualPerformance.performanceMetrics.lifeSalesConversations
                                    .variance
                                }
                              </span>
                            </div>
                          </div>
                        </div>

                        {/* Sales Closed */}
                        <div className="comparison-metric-item">
                          <div className="metric-header">
                            <div className="metric-icon sales">
                              <FontAwesomeIcon icon={faChartLine} />
                            </div>
                            <div className="metric-info">
                              <h4 className="metric-title">Sales Closed</h4>
                              <div className="metric-achievement">
                                <span
                                  className={`achievement-percentage ${individualPerformance.performanceMetrics.sales.percentage >= 100
                                    ? 'success'
                                    : individualPerformance.performanceMetrics.sales.percentage >=
                                      80
                                      ? 'warning'
                                      : 'danger'
                                    }`}
                                >
                                  {individualPerformance.performanceMetrics.sales.percentage.toFixed(
                                    1
                                  )}
                                  %
                                </span>
                                <span className="achievement-label">achievement</span>
                              </div>
                            </div>
                          </div>
                          <div className="metric-comparison">
                            <div className="comparison-bar">
                              <div className="target-bar">
                                <div
                                  ref={(el) => {
                                    if (el) {
                                      el.style.width = '100%';
                                    }
                                  }}
                                  className={`target-fill ${styles.targetFill}`}
                                ></div>
                                <span className="target-value">
                                  {individualPerformance.forecast.sales}
                                </span>
                                <span className="target-label">Target</span>
                              </div>
                              <div className="actual-bar">
                                <div
                                  ref={(el) => {
                                    if (el) {
                                      el.style.width = `${Math.min(individualPerformance.performanceMetrics.sales.percentage, 100)}%`;
                                    }
                                  }}
                                  className={`actual-fill ${styles.actualFill}`}
                                ></div>
                                <span className="actual-value">
                                  {individualPerformance.actual.sales}
                                </span>
                                <span className="actual-label">Actual</span>
                              </div>
                            </div>
                            <div className="variance-indicator">
                              <span
                                className={`variance ${individualPerformance.performanceMetrics.sales.variance >= 0 ? 'positive' : 'negative'}`}
                              >
                                {individualPerformance.performanceMetrics.sales.variance >= 0
                                  ? '+'
                                  : ''}
                                {individualPerformance.performanceMetrics.sales.variance}
                              </span>
                            </div>
                          </div>
                        </div>

                        {/* Referral Requests */}
                        <div className="comparison-metric-item">
                          <div className="metric-header">
                            <div className="metric-icon referrals">
                              <FontAwesomeIcon icon={faArrowTrendUp} />
                            </div>
                            <div className="metric-info">
                              <h4 className="metric-title">Referral Requests</h4>
                              <div className="metric-achievement">
                                <span
                                  className={`achievement-percentage ${individualPerformance.performanceMetrics.referralRequests
                                    .percentage >= 100
                                    ? 'success'
                                    : individualPerformance.performanceMetrics.referralRequests
                                      .percentage >= 80
                                      ? 'warning'
                                      : 'danger'
                                    }`}
                                >
                                  {individualPerformance.performanceMetrics.referralRequests.percentage.toFixed(
                                    1
                                  )}
                                  %
                                </span>
                                <span className="achievement-label">achievement</span>
                              </div>
                            </div>
                          </div>
                          <div className="metric-comparison">
