                        userRole={user?.role || 'AGENT'}
                      />
                    </div>
                  </div>
                )}
              </div>
            )}

            {/* Team Performance View - Only for managers viewing team */}
            {hasTeamAccess &&
              currentView === 'team' &&
              teamViewMode === 'team' &&
              teamPerformance && (
                <div className="team-performance">
                  <div className="team-overview">
                    <div className="section-header">
                      <h2 className="section-title">
                        <FontAwesomeIcon icon={faUsers} />
                        Agent Interaction Analytics
                      </h2>
                      <p className="section-subtitle">
                        Comprehensive analytics of all agent interactions and performance metrics
                        for {teamPerformance.teamSummary.totalAgents}{' '}
                        {accessLevel === 'all' ? 'agents across all teams' : 'team members'}
                      </p>
                    </div>
                    {renderMetricsCard(
                      'Aggregated Interaction Analytics',
                      teamPerformance.teamSummary,
                      null,
                      true
                    )}
                  </div>

                  <div className="agents-performance-section">
                    <div className="section-header">
                      <h3 className="section-title">
                        <FontAwesomeIcon icon={faChartLine} />
                        Individual Agent Analytics
                      </h3>
                      <p className="section-subtitle">
                        Detailed interaction analytics and performance metrics for each agent
                      </p>
                    </div>
                    <div className="agents-grid">
                      {teamPerformance.agents.map((agent) => (
                        <div key={agent.userId} className="agent-performance-card">
                          <div className="agent-card-header">
                            <div className="agent-info">
                              <div className="agent-avatar">
                                <FontAwesomeIcon icon={faUser} />
                              </div>
                              <div className="agent-details">
                                <h4 className="agent-name">{agent.userName}</h4>
                                <span className="agent-role">{agent.userRole}</span>
                              </div>
                            </div>
                            <div className="agent-actions">
                              <button
                                className="btn-view-details"
                                onClick={() => openAgentDetailModal(agent)}
                              >
                                <FontAwesomeIcon icon={faEye} />
                                View Details
                              </button>
                            </div>
                          </div>

                          <div className="agent-metrics-grid">
                            <div className="metric-item">
                              <div className="metric-header">
                                <span className="metric-label">People Contacted</span>
                                <span
                                  className={`performance-badge ${agent.performanceMetrics.peopleContacted.percentage >= 100 ? 'success' : agent.performanceMetrics.peopleContacted.percentage >= 80 ? 'warning' : 'danger'}`}
                                >
