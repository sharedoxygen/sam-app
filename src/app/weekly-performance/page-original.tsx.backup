                              <div className="metric-progress">
                                <div className="progress-bar">
                                  <div
                                    className="progress-fill"
                                    ref={(el) => {
                                      if (el) {
                                        el.style.width = `${Math.min(agent.performanceMetrics.peopleContacted.percentage, 100)}%`;
                                        el.style.background = agent.performanceMetrics.peopleContacted.percentage >= 100
                                          ? '#28a745'
                                          : agent.performanceMetrics.peopleContacted.percentage >= 80
                                            ? '#fd7e14'
                                            : '#dc3545';
                                      }
                                    }}
                                  ></div>
                                </div>
                              </div>
                            </div>

                            <div className="metric-item">
                              <div className="metric-header">
                                <span className="metric-label">Conversations</span>
                                <span
                                  className={`performance-badge ${agent.performanceMetrics.lifeSalesConversations.percentage >= 100 ? 'success' : agent.performanceMetrics.lifeSalesConversations.percentage >= 80 ? 'warning' : 'danger'}`}
                                >
                                  {agent.performanceMetrics.lifeSalesConversations.percentage}%
                                </span>
                              </div>
                              <div className="metric-value">
                                {agent.actual.lifeSalesConversations}
                              </div>
                              <div className="metric-target">
                                Target: {agent.forecast.lifeSalesConversations}
                              </div>
                              <div className="metric-progress">
                                <div className="progress-bar">
                                  <div
                                    className="progress-fill"
                                    ref={(el) => {
                                      if (el) {
