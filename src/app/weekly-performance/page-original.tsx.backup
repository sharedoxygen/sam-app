                                      el.style.width = '100%';
                                    }
                                  }}
                                  className={`target-fill ${styles.targetFill}`}
                                ></div>
                                <span className="target-value">
                                  {individualPerformance.forecast.referralRequests}
                                </span>
                                <span className="target-label">Target</span>
                              </div>
                              <div className="actual-bar">
                                <div
                                  ref={(el) => {
                                    if (el) {
                                      el.style.width = `${Math.min(individualPerformance.performanceMetrics.referralRequests.percentage, 100)}%`;
                                    }
                                  }}
                                  className={`actual-fill ${styles.actualFill}`}
                                ></div>
                                <span className="actual-value">
                                  {individualPerformance.actual.referralRequests}
                                </span>
                                <span className="actual-label">Actual</span>
                              </div>
