                                      }
                                    }}
                                  ></div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )}

            {/* Team Forecast Management View - Only for managers viewing team */}
            {hasTeamAccess &&
              currentView === 'team' &&
              teamViewMode === 'forecast' &&
              teamPerformance && (
                <div className="team-forecast-management">
                  <div className="team-forecast-header">
                    <h2>Team Forecast Management</h2>
                    <p>Review and manage forecasts for your team members</p>
                  </div>

                  <div className="team-forecast-grid">
                    {teamPerformance.agents.map((agent) => (
                      <div key={agent.userId} className="agent-forecast-card">
                        <div className="agent-forecast-header">
                          <div className="agent-info">
                            <h4>
                              <FontAwesomeIcon icon={faUser} />
                              {agent.userName}
                            </h4>
                            <span className="agent-role">{agent.userRole}</span>
                          </div>
                          <div className="forecast-status">
                            {agent.forecast.peopleContacted > 0 ||
                              agent.forecast.lifeSalesConversations > 0 ||
                              agent.forecast.sales > 0 ||
                              agent.forecast.referralRequests > 0 ? (
                              <span className="has-forecast">
                                <FontAwesomeIcon icon={faCheckCircle} />
                                Forecast Set
                              </span>
                            ) : (
                              <span className="no-forecast">
                                <FontAwesomeIcon icon={faExclamationTriangle} />
                                No Forecast
                              </span>
                            )}
                          </div>
                        </div>

                        <div className="agent-forecast-metrics">
                          <div className="forecast-metric">
                            <label>People Contacted:</label>
                            <div className="metric-display">
                              <span className="current-value">
                                {agent.forecast.peopleContacted}
                              </span>
                              <span className="vs-actual">
                                vs {agent.actual.peopleContacted} actual
                              </span>
                            </div>
                          </div>
                          <div className="forecast-metric">
                            <label>Life/Sales Conversations:</label>
                            <div className="metric-display">
                              <span className="current-value">
                                {agent.forecast.lifeSalesConversations}
                              </span>
                              <span className="vs-actual">
                                vs {agent.actual.lifeSalesConversations} actual
                              </span>
                            </div>
                          </div>
                          <div className="forecast-metric">
                            <label>Sales Closed:</label>
                            <div className="metric-display">
                              <span className="current-value">{agent.forecast.sales}</span>
                              <span className="vs-actual">vs {agent.actual.sales} actual</span>
                            </div>
                          </div>
                          <div className="forecast-metric">
                            <label>Referral Requests:</label>
                            <div className="metric-display">
                              <span className="current-value">
                                {agent.forecast.referralRequests}
                              </span>
                              <span className="vs-actual">
                                vs {agent.actual.referralRequests} actual
                              </span>
                            </div>
                          </div>
                        </div>

                        <div className="agent-forecast-actions">
                          <button
                            className="btn-edit-forecast"
                            onClick={() => openForecastEditor(agent)}
                          >
                            <FontAwesomeIcon icon={faEdit} />
                            Edit Forecast
                          </button>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

            {/* Team Comparison View - Only for managers viewing team */}
            {hasTeamAccess &&
              currentView === 'team' &&
              teamViewMode === 'comparison' &&
              teamPerformance && (
                <div className="comparison-view">
                  {/* Team Summary Elegant Comparison */}
                  <div className="elegant-comparison-card">
                    <div className="comparison-header">
                      <div className="header-content">
                        <h3 className="comparison-title">
                          <FontAwesomeIcon icon={faUsers} />
                          {accessLevel === 'all' ? 'Organization-wide' : 'Team'} Analytics Overview
                        </h3>
                        <p className="comparison-subtitle">
                          Aggregated interaction analytics across all agents in your{' '}
                          {accessLevel === 'all' ? 'organization' : 'team'}
                        </p>
                      </div>
                      <div className="overall-performance">
                        <div className="overall-score">
                          {teamPerformance.teamSummary.totalAgents}
                        </div>
                        <div className="overall-label">Total Agents</div>
                      </div>
                    </div>

                    <div className="comparison-metrics-grid">
                      {/* People Contacted */}
                      <div className="comparison-metric-item">
                        <div className="metric-header">
                          <div className="metric-icon contacts">
                            <FontAwesomeIcon icon={faPhone} />
                          </div>
                          <div className="metric-info">
                            <h4 className="metric-title">People Contacted</h4>
                            <div className="metric-achievement">
                              <span className="achievement-percentage success">
                                {teamPerformance.teamSummary.peopleContacted}
                              </span>
                              <span className="achievement-label">total interactions</span>
                            </div>
                          </div>
                        </div>
                        <div className="metric-comparison">
                          <div className="team-metric-details">
                            <div className="metric-breakdown">
                              <span className="breakdown-label">
                                Aggregated from {teamPerformance.teamSummary.totalAgents} agents
                              </span>
                              <span className="breakdown-average">
                                Avg:{' '}
                                {Math.round(
                                  teamPerformance.teamSummary.peopleContacted /
                                  teamPerformance.teamSummary.totalAgents
                                )}{' '}
                                per agent
                              </span>
                            </div>
                          </div>
                        </div>
                      </div>

                      {/* Life/Sales Conversations */}
                      <div className="comparison-metric-item">
                        <div className="metric-header">
                          <div className="metric-icon conversations">
                            <FontAwesomeIcon icon={faUser} />
                          </div>
                          <div className="metric-info">
                            <h4 className="metric-title">Life/Sales Conversations</h4>
                            <div className="metric-achievement">
                              <span className="achievement-percentage success">
                                {teamPerformance.teamSummary.lifeSalesConversations}
                              </span>
                              <span className="achievement-label">total conversations</span>
                            </div>
                          </div>
                        </div>
                        <div className="metric-comparison">
                          <div className="team-metric-details">
                            <div className="metric-breakdown">
                              <span className="breakdown-label">
                                Aggregated from {teamPerformance.teamSummary.totalAgents} agents
                              </span>
                              <span className="breakdown-average">
                                Avg:{' '}
                                {Math.round(
                                  teamPerformance.teamSummary.lifeSalesConversations /
                                  teamPerformance.teamSummary.totalAgents
                                )}{' '}
                                per agent
                              </span>
                            </div>
                          </div>
                        </div>
                      </div>

                      {/* Sales Closed */}
                      <div className="comparison-metric-item">
                        <div className="metric-header">
                          <div className="metric-icon sales">
                            <FontAwesomeIcon icon={faChartLine} />
                          </div>
                          <div className="metric-info">
                            <h4 className="metric-title">Sales Closed</h4>
                            <div className="metric-achievement">
                              <span className="achievement-percentage success">
                                {teamPerformance.teamSummary.sales}
                              </span>
                              <span className="achievement-label">total sales</span>
                            </div>
                          </div>
                        </div>
                        <div className="metric-comparison">
                          <div className="team-metric-details">
                            <div className="metric-breakdown">
                              <span className="breakdown-label">
                                Aggregated from {teamPerformance.teamSummary.totalAgents} agents
                              </span>
                              <span className="breakdown-average">
                                Avg:{' '}
                                {Math.round(
                                  teamPerformance.teamSummary.sales /
                                  teamPerformance.teamSummary.totalAgents
                                )}{' '}
                                per agent
                              </span>
                            </div>
                          </div>
                        </div>
                      </div>

                      {/* Referral Requests */}
                      <div className="comparison-metric-item">
                        <div className="metric-header">
                          <div className="metric-icon referrals">
                            <FontAwesomeIcon icon={faArrowTrendUp} />
                          </div>
                          <div className="metric-info">
                            <h4 className="metric-title">Referral Requests</h4>
                            <div className="metric-achievement">
                              <span className="achievement-percentage success">
                                {teamPerformance.teamSummary.referralRequests}
                              </span>
                              <span className="achievement-label">total referrals</span>
                            </div>
                          </div>
                        </div>
                        <div className="metric-comparison">
                          <div className="team-metric-details">
                            <div className="metric-breakdown">
                              <span className="breakdown-label">
                                Aggregated from {teamPerformance.teamSummary.totalAgents} agents
                              </span>
                              <span className="breakdown-average">
                                Avg:{' '}
                                {Math.round(
                                  teamPerformance.teamSummary.referralRequests /
                                  teamPerformance.teamSummary.totalAgents
                                )}{' '}
                                per agent
                              </span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* Individual Agent Comparisons */}
                  <div className="agent-comparisons-section">
                    <div className="section-header">
                      <h3 className="section-title">
                        <FontAwesomeIcon icon={faChartLine} />
                        Individual Agent Performance Comparison
                      </h3>
                      <p className="section-subtitle">
                        Detailed comparison of each agent's interaction analytics and achievements
                      </p>
                    </div>

                    <div className="agent-comparison-grid">
                      {teamPerformance.agents.map((agent) => (
                        <div key={agent.userId} className="agent-comparison-card">
                          <div className="agent-comparison-header">
                            <div className="agent-info">
                              <div className="agent-avatar">
                                <FontAwesomeIcon icon={faUser} />
                              </div>
                              <div className="agent-details">
                                <h4 className="agent-name">{agent.userName}</h4>
                                <span className="agent-role">{agent.userRole}</span>
                              </div>
                            </div>
                            <div className="agent-overall-score">
                              <div className="score-value">
                                {Math.round(
                                  (agent.performanceMetrics.peopleContacted.percentage +
                                    agent.performanceMetrics.lifeSalesConversations.percentage +
                                    agent.performanceMetrics.sales.percentage +
                                    agent.performanceMetrics.referralRequests.percentage) /
                                  4
                                )}
                                %
                              </div>
                              <div className="score-label">Achievement</div>
                            </div>
                          </div>

                          <div className="agent-metrics-comparison">
                            <div className="agent-metric-row">
                              <div className="metric-info">
                                <span className="metric-name">People Contacted</span>
                                <div className="metric-values">
                                  <span className="actual-value">
                                    {agent.actual.peopleContacted}
                                  </span>
                                  <span className="vs">vs</span>
                                  <span className="target-value">
                                    {agent.forecast.peopleContacted}
                                  </span>
                                </div>
                              </div>
                              <div className="metric-progress">
                                <div className="progress-bar">
                                  <div
                                    className="progress-fill"
                                    ref={(el) => {
                                      if (el) {
                                        el.style.width = `${Math.min(agent.performanceMetrics.peopleContacted.percentage, 100)}%`;
                                        el.style.background = agent.performanceMetrics.peopleContacted.percentage >= 100
                                          ? '#28a745'
                                          : agent.performanceMetrics.peopleContacted.percentage >= 80
                                            ? '#fd7e14'
                                            : '#dc3545';
                                      }
                                    }}
                                  ></div>
                                </div>
                                <span
                                  className={`percentage ${agent.performanceMetrics.peopleContacted.percentage >= 100
                                    ? 'success'
                                    : agent.performanceMetrics.peopleContacted.percentage >= 80
                                      ? 'warning'
                                      : 'danger'
                                    }`}
                                >
                                  {agent.performanceMetrics.peopleContacted.percentage.toFixed(1)}%
                                </span>
                              </div>
                            </div>

                            <div className="agent-metric-row">
                              <div className="metric-info">
                                <span className="metric-name">Conversations</span>
                                <div className="metric-values">
                                  <span className="actual-value">
                                    {agent.actual.lifeSalesConversations}
                                  </span>
                                  <span className="vs">vs</span>
                                  <span className="target-value">
                                    {agent.forecast.lifeSalesConversations}
                                  </span>
                                </div>
                              </div>
                              <div className="metric-progress">
                                <div className="progress-bar">
                                  <div
                                    className="progress-fill"
                                    style={{
                                      width: `${Math.min(agent.performanceMetrics.lifeSalesConversations.percentage, 100)}%`,
                                      background:
                                        agent.performanceMetrics.lifeSalesConversations
                                          .percentage >= 100
                                          ? '#28a745'
                                          : agent.performanceMetrics.lifeSalesConversations
                                            .percentage >= 80
                                            ? '#fd7e14'
                                            : '#dc3545',
                                    }}
                                  ></div>
                                </div>
                                <span
                                  className={`percentage ${agent.performanceMetrics.lifeSalesConversations.percentage >=
                                    100
                                    ? 'success'
                                    : agent.performanceMetrics.lifeSalesConversations
                                      .percentage >= 80
                                      ? 'warning'
                                      : 'danger'
                                    }`}
                                >
                                  {agent.performanceMetrics.lifeSalesConversations.percentage.toFixed(
                                    1
                                  )}
                                  %
                                </span>
                              </div>
                            </div>

                            <div className="agent-metric-row">
                              <div className="metric-info">
                                <span className="metric-name">Sales Closed</span>
                                <div className="metric-values">
                                  <span className="actual-value">{agent.actual.sales}</span>
                                  <span className="vs">vs</span>
                                  <span className="target-value">{agent.forecast.sales}</span>
                                </div>
                              </div>
                              <div className="metric-progress">
                                <div className="progress-bar">
                                  <div
                                    className="progress-fill"
                                    style={{
                                      width: `${Math.min(agent.performanceMetrics.sales.percentage, 100)}%`,
                                      background:
                                        agent.performanceMetrics.sales.percentage >= 100
                                          ? '#28a745'
                                          : agent.performanceMetrics.sales.percentage >= 80
                                            ? '#fd7e14'
                                            : '#dc3545',
                                    }}
                                  ></div>
                                </div>
                                <span
                                  className={`percentage ${agent.performanceMetrics.sales.percentage >= 100
                                    ? 'success'
                                    : agent.performanceMetrics.sales.percentage >= 80
                                      ? 'warning'
                                      : 'danger'
                                    }`}
                                >
                                  {agent.performanceMetrics.sales.percentage.toFixed(1)}%
                                </span>
                              </div>
                            </div>

                            <div className="agent-metric-row">
                              <div className="metric-info">
                                <span className="metric-name">Referral Requests</span>
                                <div className="metric-values">
                                  <span className="actual-value">
                                    {agent.actual.referralRequests}
                                  </span>
                                  <span className="vs">vs</span>
                                  <span className="target-value">
                                    {agent.forecast.referralRequests}
                                  </span>
                                </div>
                              </div>
                              <div className="metric-progress">
                                <div className="progress-bar">
                                  <div
                                    className="progress-fill"
                                    style={{
                                      width: `${Math.min(agent.performanceMetrics.referralRequests.percentage, 100)}%`,
                                      background:
                                        agent.performanceMetrics.referralRequests.percentage >= 100
                                          ? '#28a745'
                                          : agent.performanceMetrics.referralRequests.percentage >=
                                            80
                                            ? '#fd7e14'
                                            : '#dc3545',
                                    }}
                                  ></div>
                                </div>
                                <span
                                  className={`percentage ${agent.performanceMetrics.referralRequests.percentage >= 100
                                    ? 'success'
                                    : agent.performanceMetrics.referralRequests.percentage >= 80
                                      ? 'warning'
                                      : 'danger'
                                    }`}
                                >
                                  {agent.performanceMetrics.referralRequests.percentage.toFixed(1)}%
                                </span>
                              </div>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>

                  {/* Team Summary Charts */}
                  <div className="charts-wrapper">
                    <ModernPerformanceCharts
                      forecast={teamPerformance.teamSummary}
                      actual={teamPerformance.teamSummary}
                      performanceMetrics={{
                        peopleContacted: {
                          actual: teamPerformance.teamSummary.peopleContacted,
                          forecast: teamPerformance.teamSummary.peopleContacted,
                          percentage: 100,
                          variance: 0,
                        },
                        lifeSalesConversations: {
                          actual: teamPerformance.teamSummary.lifeSalesConversations,
                          forecast: teamPerformance.teamSummary.lifeSalesConversations,
                          percentage: 100,
                          variance: 0,
                        },
                        sales: {
                          actual: teamPerformance.teamSummary.sales,
                          forecast: teamPerformance.teamSummary.sales,
                          percentage: 100,
                          variance: 0,
                        },
                        referralRequests: {
                          actual: teamPerformance.teamSummary.referralRequests,
                          forecast: teamPerformance.teamSummary.referralRequests,
                          percentage: 100,
                          variance: 0,
                        },
                      }}
                      userRole={user?.role || 'SUPERVISOR'}
                    />
                  </div>
                </div>
              )}
          </>
        )}
      </div>

      {/* Forecast Editing Modal */}
      {showForecastModal && editingAgent && (
        <div className="modal-overlay" onClick={closeForecastEditor}>
          <div className="forecast-modal" onClick={(e) => e.stopPropagation()}>
            <div className="modal-header">
              <h3>
                <FontAwesomeIcon icon={faEdit} />
                Edit Forecast for {editingAgent.userName}
              </h3>
              <button className="modal-close" onClick={closeForecastEditor}>
                ×
              </button>
            </div>

            <div className="modal-body">
              <div className="forecast-form">
                <div className="form-group">
                  <label>People Contacted:</label>
                  <div className="input-with-actual">
                    <input
                      type="number"
                      value={editingAgent.forecast.peopleContacted}
                      onChange={(e) =>
                        updateEditingForecast('peopleContacted', parseInt(e.target.value) || 0)
                      }
                    />
                    <span className="actual-value">
                      Actual: {editingAgent.actual.peopleContacted}
                    </span>
                  </div>
                </div>

                <div className="form-group">
                  <label>Life/Sales Conversations:</label>
                  <div className="input-with-actual">
                    <input
                      type="number"
                      value={editingAgent.forecast.lifeSalesConversations}
                      onChange={(e) =>
                        updateEditingForecast(
                          'lifeSalesConversations',
                          parseInt(e.target.value) || 0
                        )
                      }
                    />
                    <span className="actual-value">
                      Actual: {editingAgent.actual.lifeSalesConversations}
                    </span>
                  </div>
                </div>

                <div className="form-group">
                  <label>Sales Closed:</label>
                  <div className="input-with-actual">
                    <input
                      type="number"
                      value={editingAgent.forecast.sales}
                      onChange={(e) =>
                        updateEditingForecast('sales', parseInt(e.target.value) || 0)
                      }
                    />
                    <span className="actual-value">Actual: {editingAgent.actual.sales}</span>
                  </div>
                </div>

                <div className="form-group">
                  <label>Referral Requests:</label>
                  <div className="input-with-actual">
                    <input
                      type="number"
                      value={editingAgent.forecast.referralRequests}
                      onChange={(e) =>
                        updateEditingForecast('referralRequests', parseInt(e.target.value) || 0)
                      }
                    />
                    <span className="actual-value">
                      Actual: {editingAgent.actual.referralRequests}
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <div className="modal-footer">
              <button className="btn-cancel" onClick={closeForecastEditor}>
                Cancel
              </button>
              <button
                className="btn-save"
                onClick={saveAgentForecast}
                disabled={saveStatus === 'saving'}
              >
                <FontAwesomeIcon icon={saveStatus === 'saving' ? faSpinner : faSave} />
                {saveStatus === 'saving' ? 'Saving...' : 'Save Forecast'}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Agent Detail Modal */}
      {showAgentDetailModal && selectedAgentDetails && (
        <div className="modal-overlay" onClick={closeAgentDetailModal}>
          <div className="agent-detail-modal" onClick={(e) => e.stopPropagation()}>
            <div className="modal-header">
              <div className="agent-header-info">
                <div className="agent-avatar-large">
                  <FontAwesomeIcon icon={faUser} />
                </div>
                <div className="agent-header-details">
                  <h3>{selectedAgentDetails.userName}</h3>
                  <span className="agent-role-badge">{selectedAgentDetails.userRole}</span>
                </div>
              </div>
              <button className="modal-close" onClick={closeAgentDetailModal}>
                ×
              </button>
            </div>

            <div className="modal-body">
              <div className="detail-sections">
                {/* Performance Overview */}
                <div className="detail-section">
                  <h4>
                    <FontAwesomeIcon icon={faChartLine} />
                    Performance Overview
                  </h4>
                  <div className="performance-overview-grid">
                    <div className="overview-metric">
                      <div className="metric-header">
                        <span className="metric-name">People Contacted</span>
                        <span
                          className={`performance-indicator ${selectedAgentDetails.performanceMetrics.peopleContacted.percentage >= 100 ? 'success' : selectedAgentDetails.performanceMetrics.peopleContacted.percentage >= 80 ? 'warning' : 'danger'}`}
                        >
                          {selectedAgentDetails.performanceMetrics.peopleContacted.percentage}%
                        </span>
                      </div>
                      <div className="metric-values">
                        <div className="actual-value">
                          <span className="value">
                            {selectedAgentDetails.actual.peopleContacted}
                          </span>
                          <span className="label">Actual</span>
                        </div>
                        <div className="vs-divider">vs</div>
                        <div className="forecast-value">
                          <span className="value">
                            {selectedAgentDetails.forecast.peopleContacted}
                          </span>
                          <span className="label">Forecast</span>
                        </div>
                      </div>
                      <div className="variance">
                        <span
                          className={`variance-value ${selectedAgentDetails.performanceMetrics.peopleContacted.variance >= 0 ? 'positive' : 'negative'}`}
                        >
                          {selectedAgentDetails.performanceMetrics.peopleContacted.variance >= 0
                            ? '+'
                            : ''}
                          {selectedAgentDetails.performanceMetrics.peopleContacted.variance}
                        </span>
                        <span className="variance-label">variance</span>
                      </div>
                    </div>

                    <div className="overview-metric">
                      <div className="metric-header">
                        <span className="metric-name">Life/Sales Conversations</span>
                        <span
                          className={`performance-indicator ${selectedAgentDetails.performanceMetrics.lifeSalesConversations.percentage >= 100 ? 'success' : selectedAgentDetails.performanceMetrics.lifeSalesConversations.percentage >= 80 ? 'warning' : 'danger'}`}
                        >
                          {
                            selectedAgentDetails.performanceMetrics.lifeSalesConversations
                              .percentage
                          }
                          %
                        </span>
                      </div>
                      <div className="metric-values">
                        <div className="actual-value">
                          <span className="value">
                            {selectedAgentDetails.actual.lifeSalesConversations}
                          </span>
                          <span className="label">Actual</span>
                        </div>
                        <div className="vs-divider">vs</div>
                        <div className="forecast-value">
                          <span className="value">
                            {selectedAgentDetails.forecast.lifeSalesConversations}
                          </span>
                          <span className="label">Forecast</span>
                        </div>
                      </div>
                      <div className="variance">
                        <span
                          className={`variance-value ${selectedAgentDetails.performanceMetrics.lifeSalesConversations.variance >= 0 ? 'positive' : 'negative'}`}
                        >
                          {selectedAgentDetails.performanceMetrics.lifeSalesConversations
                            .variance >= 0
                            ? '+'
                            : ''}
                          {selectedAgentDetails.performanceMetrics.lifeSalesConversations.variance}
                        </span>
                        <span className="variance-label">variance</span>
                      </div>
                    </div>

                    <div className="overview-metric">
                      <div className="metric-header">
                        <span className="metric-name">Sales Closed</span>
                        <span
                          className={`performance-indicator ${selectedAgentDetails.performanceMetrics.sales.percentage >= 100 ? 'success' : selectedAgentDetails.performanceMetrics.sales.percentage >= 80 ? 'warning' : 'danger'}`}
                        >
                          {selectedAgentDetails.performanceMetrics.sales.percentage}%
                        </span>
                      </div>
                      <div className="metric-values">
                        <div className="actual-value">
                          <span className="value">{selectedAgentDetails.actual.sales}</span>
                          <span className="label">Actual</span>
                        </div>
                        <div className="vs-divider">vs</div>
                        <div className="forecast-value">
                          <span className="value">{selectedAgentDetails.forecast.sales}</span>
                          <span className="label">Forecast</span>
                        </div>
                      </div>
                      <div className="variance">
                        <span
                          className={`variance-value ${selectedAgentDetails.performanceMetrics.sales.variance >= 0 ? 'positive' : 'negative'}`}
                        >
                          {selectedAgentDetails.performanceMetrics.sales.variance >= 0 ? '+' : ''}
                          {selectedAgentDetails.performanceMetrics.sales.variance}
                        </span>
                        <span className="variance-label">variance</span>
                      </div>
                    </div>

                    <div className="overview-metric">
                      <div className="metric-header">
                        <span className="metric-name">Referral Requests</span>
                        <span
                          className={`performance-indicator ${selectedAgentDetails.performanceMetrics.referralRequests.percentage >= 100 ? 'success' : selectedAgentDetails.performanceMetrics.referralRequests.percentage >= 80 ? 'warning' : 'danger'}`}
                        >
                          {selectedAgentDetails.performanceMetrics.referralRequests.percentage}%
                        </span>
                      </div>
                      <div className="metric-values">
                        <div className="actual-value">
                          <span className="value">
                            {selectedAgentDetails.actual.referralRequests}
                          </span>
                          <span className="label">Actual</span>
                        </div>
                        <div className="vs-divider">vs</div>
                        <div className="forecast-value">
                          <span className="value">
                            {selectedAgentDetails.forecast.referralRequests}
                          </span>
                          <span className="label">Forecast</span>
                        </div>
                      </div>
                      <div className="variance">
                        <span
                          className={`variance-value ${selectedAgentDetails.performanceMetrics.referralRequests.variance >= 0 ? 'positive' : 'negative'}`}
                        >
                          {selectedAgentDetails.performanceMetrics.referralRequests.variance >= 0
                            ? '+'
                            : ''}
                          {selectedAgentDetails.performanceMetrics.referralRequests.variance}
                        </span>
                        <span className="variance-label">variance</span>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Performance Summary */}
                <div className="detail-section">
                  <h4>
                    <FontAwesomeIcon icon={faTarget} />
                    Performance Summary
                  </h4>
                  <div className="summary-stats">
                    <div className="summary-stat">
                      <div className="stat-label">Overall Performance</div>
                      <div className="stat-value">
                        {Math.round(
                          (selectedAgentDetails.performanceMetrics.peopleContacted.percentage +
                            selectedAgentDetails.performanceMetrics.lifeSalesConversations
                              .percentage +
                            selectedAgentDetails.performanceMetrics.sales.percentage +
                            selectedAgentDetails.performanceMetrics.referralRequests.percentage) /
                          4
                        )}
                        %
                      </div>
                    </div>
                    <div className="summary-stat">
                      <div className="stat-label">Goals Met</div>
                      <div className="stat-value">
                        {
                          [
                            selectedAgentDetails.performanceMetrics.peopleContacted.percentage >=
                            100,
                            selectedAgentDetails.performanceMetrics.lifeSalesConversations
                              .percentage >= 100,
                            selectedAgentDetails.performanceMetrics.sales.percentage >= 100,
                            selectedAgentDetails.performanceMetrics.referralRequests.percentage >=
                            100,
                          ].filter(Boolean).length
                        }{' '}
                        / 4
                      </div>
                    </div>
                    <div className="summary-stat">
                      <div className="stat-label">Top Metric</div>
                      <div className="stat-value">
                        {(() => {
                          const metrics = selectedAgentDetails.performanceMetrics;
                          const maxMetric = Math.max(
                            metrics.peopleContacted.percentage,
                            metrics.lifeSalesConversations.percentage,
                            metrics.sales.percentage,
                            metrics.referralRequests.percentage
                          );
                          if (maxMetric === metrics.peopleContacted.percentage) return 'Contacts';
                          if (maxMetric === metrics.lifeSalesConversations.percentage)
                            return 'Conversations';
                          if (maxMetric === metrics.sales.percentage) return 'Sales';
                          return 'Referrals';
                        })()}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div className="modal-footer">
              <button className="btn-close" onClick={closeAgentDetailModal}>
                Close
              </button>
              {canEdit && (
                <button
                  className="btn-edit-forecast"
                  onClick={() => {
                    closeAgentDetailModal();
                    openForecastEditor(selectedAgentDetails);
                  }}
                >
                  <FontAwesomeIcon icon={faEdit} />
                  Edit Forecast
                </button>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
